AUTOMATION_DB_PATH=automation.db
LOG_LEVEL=INFO
RETRY_DELAY_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1

# Direct API execution
TARGET_API_BASE_URL=https://api.example.internal
TARGET_API_TOKEN=
TARGET_API_TIMEOUT_SECONDS=10

# Vendor-neutral RPA gateway/platform submission
RPA_SUBMIT_URL=https://rpa-gateway.example.internal/jobs
RPA_SUBMIT_TOKEN=
RPA_SUBMIT_TIMEOUT_SECONDS=10

# Optional document enrichment through an OpenAI-compatible endpoint
LLM_BASE_URL=https://llm-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model
LLM_TIMEOUT_SECONDS=20
