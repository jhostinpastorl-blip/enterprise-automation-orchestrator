# Local SQLite fallback
AUTOMATION_DB_PATH=automation.db

# Optional production database URL. When set, it overrides AUTOMATION_DB_PATH.
# Example: postgresql+psycopg://automation:automation@postgres:5432/automation
AUTOMATION_DATABASE_URL=

# Dispatch backend: database or redis
DISPATCH_BACKEND=database
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=automation:requests

LOG_LEVEL=INFO
RETRY_DELAY_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1

# Optional API protection. When set, non-public endpoints require X-API-Key.
ORCHESTRATOR_API_KEY=

# Direct API execution
TARGET_API_BASE_URL=https://api.example.internal
TARGET_API_TOKEN=
TARGET_API_TIMEOUT_SECONDS=10

# RPA provider: gateway or uipath
RPA_PROVIDER=gateway

# Vendor-neutral RPA gateway/platform submission
RPA_SUBMIT_URL=https://rpa-gateway.example.internal/jobs
RPA_SUBMIT_TOKEN=
RPA_SUBMIT_TIMEOUT_SECONDS=10

# UiPath Orchestrator client-credentials integration
UIPATH_TOKEN_URL=https://cloud.uipath.com/identity_/connect/token
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com/<organization>/<tenant>/orchestrator_
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_RELEASE_KEY=
UIPATH_FOLDER_ID=
UIPATH_TIMEOUT_SECONDS=15

# Optional document enrichment through an OpenAI-compatible endpoint
LLM_BASE_URL=https://llm-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model
LLM_TIMEOUT_SECONDS=20
